# Supabase → Project Settings → API. Leave blank to run in local (same-browser) demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI agent (server-side only: never add a VITE_ prefix to these, or they'd be exposed in the browser).
# Free option: Gemini key from aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Optional: GEMINI_MODEL (default gemini-2.5-flash)
GEMINI_MODEL=
# Paid option: Claude key from console.anthropic.com (separate from a Claude Pro plan)
ANTHROPIC_API_KEY=
# Optional: ANTHROPIC_MODEL (default claude-sonnet-5-5)
ANTHROPIC_MODEL=
# Optional: force a provider when both keys are set: gemini | claude
AI_PROVIDER=
